# ProxyND 환경 변수 예제
# 이 파일을 .env로 복사하여 사용하세요.
# 환경별로 .env.development, .env.production 등으로 분리할 수 있습니다.

# 환경 설정
PROXYND_ENV=development

# 서버 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# TLS 설정
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# 캐시 설정
CACHE_BACKEND=file
CACHE_TTL=3600s
CACHE_MAX_SIZE=10GB
STORAGE_DIR=/var/cache/proxynd

# S3 캐시 설정 (선택사항)
S3_ENDPOINT=s3.amazonaws.com
S3_BUCKET=proxynd-cache
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis 캐시 설정 (선택사항)
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# 레지스트리 설정
NPM_ENABLED=true
NPM_UPSTREAM=https://registry.npmjs.org
PYPI_ENABLED=true
PYPI_UPSTREAM=https://pypi.org
APT_ENABLED=true
DOCKER_ENABLED=true
MAVEN_ENABLED=true

# Docker 레지스트리 인증
DOCKER_USERNAME=
DOCKER_PASSWORD=
REGISTRY_PASSWORD=

# 보안 설정
AUTH_ENABLED=false
AUTH_USERS_FILE=users.yml
IP_WHITELIST_ENABLED=false

# LDAP 설정 (선택사항)
LDAP_PASSWORD=

# 패키지 검증
VERIFICATION_ENABLED=false
VERIFICATION_BLOCK=false
VERIFICATION_ALERT=true

# 알림 설정
ALERTS_ENABLED=false
WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# 로깅 설정
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=
ACCESS_LOG_ENABLED=true
ACCESS_LOG_PATH=

# 메트릭 설정
METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_PORT=9090

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-here-minimum-32-chars
JWT_EXPIRY_HOURS=24

# OAuth2 Providers
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_GITLAB_CLIENT_ID=your-gitlab-client-id
OAUTH_GITLAB_CLIENT_SECRET=your-gitlab-client-secret
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database (if used)
DB_PASSWORD=your-database-password
DB_CONNECTION_STRING=your-connection-string

# External APIs
UPSTREAM_API_KEY=your-upstream-api-key
WEBHOOK_SECRET=your-webhook-secret

# 고급 설정
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30s
RETRY_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_ENABLED=false
