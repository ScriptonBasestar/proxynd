# ====================
# ProxyND Core .gitignore
# ====================

# Go build artifacts
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Build outputs
bin/
build/
dist/
release/

# Coverage and profiling
coverage/
coverage.*
*.cover
*.coverprofile
coverage.out
profile.out
*.prof
*.pprof
*.trace
cpu.out
mem.out

# Temporary files and caches
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~
.gocache/
.gotmp/
.DS_Store
Thumbs.db

# Logs and runtime data
logs/
!logs/.gitkeep
log/
storage/
!storage/.gitkeep
*.log
*.pid
*.pid.lock

# Configuration and secrets
.env
.env.*
!.env.example
!deployments/systemd/*.env
config.local.*
config/*.local.*
config/*.override.*
config/*.secret.*
secrets/
.secret/
.secrets/
*.key
*.pem
*.pfx
*.p12
*.crt
*.cert

# Distribution archives
artifacts/
*.tar
*.tar.gz
*.tgz
*.zip

# Dependency vendors
vendor/

# Container and tooling overrides
docker-compose.override.yml
.docker/
*.kubeconfig

# IDE and editor settings
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
*.sublime-*
.fleet/
.cursor/
*.code-workspace

# Static analysis and local tooling artifacts
*.sarif
*.report.json
.claude/
CLAUDE.local.md
