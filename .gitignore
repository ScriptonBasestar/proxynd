# ====================
# ProxyND .gitignore
# ====================

# ================
# Go Language
# ================
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.cover
coverage.out
coverage.html
coverage.txt
profile.out

# Go workspace files
go.work
go.work.sum

# Go build cache
.cache/go-build/

# ================
# Application Specific
# ================
# ProxyND binaries
proxynd
proxyndctl
/proxynd
/proxyndctl
cmd/proxynd/proxynd
cmd/proxyndctl/proxyndctl

# Build outputs
/dist/
/bin/
/tmp/main
main
main.exe

# Application directories with preserved structure
tmp/
temp/
cache/
storage/
logs/
log/

# Preserve directory structure with .gitkeep
!/tmp/.gitkeep
!/cache/.gitkeep
!/storage/.gitkeep
!/logs/.gitkeep

# ================
# Development & Testing
# ================
# Test artifacts
test-results/
test-reports/
junit.xml
.nyc_output/

# Coverage reports
coverage/
*.cover
*.coverprofile

# Profiling & Performance
*.prof
*.trace
*.heap
*.cpu
*.mem
*.pprof
*.profile

# Benchmark results
benchmark-*.txt
*.bench

# ================
# Configuration & Environment
# ================
# Environment files
.env
.env.*
!.env.example
!systemd/*.env

# Local configuration overrides
config.local.yaml
config.local.yml
config.development.yaml
config.development.yml
config.production.yaml
config.production.yml
config.staging.yaml
config.staging.yml

# ================
# Security & Secrets
# ================
# SSL/TLS certificates and keys
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# Secret directories and files
secrets/
.secrets
.secret

# Authentication files
.auth
auth.json
credentials.json

# ================
# Analysis & Reports
# ================
# Security analysis reports
gosec-report.json
security-scan.json
security-report.json
vulnerability-report.json
staticcheck-report.json
golangci-lint-report.json

# Dependency analysis
deps-graph.png
dependency-check-report.html

# Code analysis
*.sarif

# ================
# Development Tools & IDEs
# ================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Vim/Neovim
*.swp
*.swo
*~
.vimrc.local
.nvimrc.local
tags
.tags

# Sublime Text
*.sublime-*

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ================
# Operating Systems
# ================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fuse_hidden*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
[Dd]esktop.ini

# Linux
.directory
.Trash-*
.nfs*

# ================
# Package Managers & Dependencies
# ================
# Go modules backup
go.sum.backup

# Node.js (for frontend tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
*.tgz

# Dependency directories
vendor/

# ================
# Containers & Deployment
# ================
# Docker
docker-compose.override.yml
.docker/
.dockerignore

# Kubernetes
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Cloud providers
.aws/
.gcp/
.azure/

# ================
# Temporary & Cache Files
# ================
# Temporary files
*.tmp
*.temp
*.backup
*.bak
*.orig
*.save

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Cache directories
.cache/
.npm/
.yarn/
.pnpm-store/

# ================
# Documentation & Build Artifacts
# ================
# Documentation builds
docs/build/
docs/_build/
site/
_site/

# Archives & Packages
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.deb
*.rpm
*.dmg
*.pkg
*.msi

# ================
# Local Development
# ================
# Local development directories
.local/
local/
dev/
development/

# Editor workspace files
*.code-workspace

# Local scripts and notes
local-*
notes.md
todo.md
scratch.*

# ================
# Monitoring & Logs
# ================
# Application logs
*.log
application.log
error.log
access.log
debug.log

# System monitoring
*.monitoring

# ================
# Database Files
