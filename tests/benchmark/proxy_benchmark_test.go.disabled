// BenchmarkProxyRequest_CachedResponse 캐시된 응답 벤치마크
func BenchmarkProxyRequest_CachedResponse(b *testing.B) {
	setup := setupBenchmarkTest(b, "npm")
	defer setup.upstreamServer.Close()
	
	ctx := context.Background()
	req := proxy.ProxyRequest{
		Method:  "GET",
		Path:    "/metadata",
		Headers: make(map[string]string),
	}
	
	// 캐시 워밍업
	_, err := setup.proxyService.HandleRequest(ctx, req)
	if err != nil {
		b.Fatalf("Cache warmup failed: %v", err)
	}
	
	b.ResetTimer()
	b.ReportAllocs()
	
	for i := 0; i < b.N; i++ {
		_, err := setup.proxyService.HandleRequest(ctx, req)
		if err != nil {
			b.Fatalf("Request failed: %v", err)
		}
	}
}

// BenchmarkProxyRequest_ConcurrentRequests 동시 요청 벤치마크
func BenchmarkProxyRequest_ConcurrentRequests(b *testing.B) {
	setup := setupBenchmarkTest(b, "npm")
	defer setup.upstreamServer.Close()
	
	ctx := context.Background()
	req := proxy.ProxyRequest{
		Method:  "GET",
		Path:    "/small-package",
		Headers: make(map[string]string),
	}
	
	b.ResetTimer()
	b.ReportAllocs()
	
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			_, err := setup.proxyService.HandleRequest(ctx, req)
			if err != nil {
				b.Errorf("Request failed: %v", err)
			}
		}
	})
}

