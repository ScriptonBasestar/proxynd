package benchmark

import (
	"context"
	"fmt"
	"net/http"
	"net/http/httptest"
	"path/filepath"
	"testing"

	"proxynd/cache"
	"proxynd/configs"
	"proxynd/internal/services/adapters"
	"proxynd/internal/services/config"
	"proxynd/internal/services/proxy"
)

// BenchmarkSetup 벤치마크 테스트를 위한 설정
type BenchmarkSetup struct {
	tempDir         string
	configService   config.Service
	cacheManager    *cache.Manager
	upstreamServer  *httptest.Server
	proxyService    proxy.ProxyService
}

// setupBenchmarkTest 벤치마크 테스트 환경 설정
func setupBenchmarkTest(b *testing.B, proxyType string) *BenchmarkSetup {
	b.Helper()
	
	tempDir := b.TempDir()
	
	// Mock upstream 서버 설정
	upstreamServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// 다양한 크기의 응답 시뮬레이션
		switch r.URL.Path {
		case "/small-package":
			w.Header().Set("Content-Type", "application/octet-stream")
			w.Write(make([]byte, 1024)) // 1KB
		case "/medium-package":
			w.Header().Set("Content-Type", "application/octet-stream")
			w.Write(make([]byte, 1024*1024)) // 1MB
		case "/large-package":
			w.Header().Set("Content-Type", "application/octet-stream")
			w.Write(make([]byte, 10*1024*1024)) // 10MB
		case "/metadata":
			w.Header().Set("Content-Type", "application/json")
			w.Write([]byte(`{"name":"test-package","version":"1.0.0"}`))
		default:
			w.WriteHeader(http.StatusNotFound)
		}
	}))
	
	// 캐시 매니저 설정
	cacheBackend, err := cache.NewFileSystemBackendWithConfig(cache.FileSystemConfig{
		Path: filepath.Join(tempDir, "cache"),
	})
	if err != nil {
		b.Fatalf("Failed to create cache backend: %v", err)
	}
	cacheManager := cache.NewManager(cacheBackend)
	
	// 업스트림 클라이언트 설정
	upstreamClient := adapters.NewUpstreamClient(configs.UpstreamConfig{
		Timeout:    30,
		MaxRetries: 3,
		UserAgent:  "ProxyND-Benchmark/1.0",
	})
	
	// 캐시 어댑터 설정
	cacheAdapter := adapters.NewCacheAdapter(cacheManager)
	
	// 설정 서비스 설정
	var proxyConfig interface{}
	switch proxyType {
	case "maven":
		proxyConfig = &configs.MavenProxyConfig{
			Proxies: map[string]configs.MavenProxy{
				"test": {
					Name:     "test",
					URL:      upstreamServer.URL,
					Enabled:  true,
					Priority: 1,
					Cache: configs.CacheConfig{
						TTL:     3600,
						Enabled: true,
					},
				},
			},
		}
	case "apt":
		proxyConfig = &configs.APTProxyConfig{
			Proxies: map[string]configs.APTProxy{
				"test": {
					Name:     "test",
					URL:      upstreamServer.URL,
					Enabled:  true,
					Priority: 1,
					Cache: configs.CacheConfig{
						TTL:     3600,
						Enabled: true,
					},
				},
			},
		}
	case "npm":
		proxyConfig = &configs.NPMProxyConfig{
			Proxies: map[string]configs.NPMProxy{
				"test": {
					Name:     "test",
					URL:      upstreamServer.URL,
					Enabled:  true,
					Priority: 1,
					Cache: configs.CacheConfig{
						TTL:     3600,
						Enabled: true,
					},
				},
			},
		}
	}
	
	configService := config.NewMockService(proxyConfig)
	
	// 프록시 서비스 생성
	proxyService, err := proxy.NewService(proxyType, configService, cacheAdapter, upstreamClient)
	if err != nil {
		b.Fatalf("Failed to create proxy service: %v", err)
	}
	
	return &BenchmarkSetup{
		tempDir:        tempDir,
		configService:  configService,
		cacheManager:   cacheManager,
		upstreamServer: upstreamServer,
		proxyService:   proxyService,
	}
}

// BenchmarkProxyRequest_SmallPackage 작은 패키지 요청 벤치마크
func BenchmarkProxyRequest_SmallPackage(b *testing.B) {
	setup := setupBenchmarkTest(b, "npm")
	defer setup.upstreamServer.Close()
	
	ctx := context.Background()
	req := proxy.ProxyRequest{
		Method:  "GET",
		Path:    "/small-package",
		Headers: make(map[string]string),
	}
	
	b.ResetTimer()
	b.ReportAllocs()
	
	for i := 0; i < b.N; i++ {
		_, err := setup.proxyService.HandleRequest(ctx, req)
		if err != nil {
			b.Fatalf("Request failed: %v", err)
		}
	}
}

