// BenchmarkCacheOperationsSimple 캐시 작업 성능 벤치마크
func BenchmarkCacheOperationsSimple(b *testing.B) {
	tempDir := b.TempDir()
	cacheBackend, err := cache.NewFileSystemBackendWithConfig(cache.FileSystemConfig{
		Path: filepath.Join(tempDir, "cache"),
	})
	if err != nil {
		b.Fatalf("Failed to create cache backend: %v", err)
	}
	cacheManager := cache.NewManager(cacheBackend)
	
	testData := make([]byte, 1024) // 1KB 테스트 데이터
	
	b.Run("Put", func(b *testing.B) {
		b.ReportAllocs()
		for i := 0; i < b.N; i++ {
			key := fmt.Sprintf("test-key-%d", i)
			err := cacheManager.Put(key, testData, 3600)
			if err != nil {
				b.Fatalf("Cache put failed: %v", err)
			}
		}
	})
	
	// 캐시에 데이터 준비
	for i := 0; i < 100; i++ {
		key := fmt.Sprintf("bench-key-%d", i)
		cacheManager.Put(key, testData, 3600)
	}
	
	b.Run("Get", func(b *testing.B) {
		b.ReportAllocs()
		for i := 0; i < b.N; i++ {
			key := fmt.Sprintf("bench-key-%d", i%100)
			_, err := cacheManager.Get(key)
			if err != nil {
				b.Fatalf("Cache get failed: %v", err)
			}
		}
	})
}


// BenchmarkMemoryUsage 메모리 사용량 벤치마크
