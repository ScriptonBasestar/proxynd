// BenchmarkAuthMiddleware 인증 미들웨어 성능 벤치마크
func BenchmarkAuthMiddleware(b *testing.B) {
	app := fiber.New(fiber.Config{
		DisableStartupMessage: true,
	})

	// 인증 설정
	authConfig := configs.AuthConfig{
		Enabled: true,
		JWT: configs.JWTConfig{
			Enabled:    true,
			Secret:     "test-secret-key-for-benchmark",
			Expiration: 3600,
		},
		BasicAuth: configs.BasicAuthConfig{
			Enabled: true,
			Users: map[string]string{
				"testuser": "testpass",
			},
		},
	}

	app.Use(middlewares.AuthMiddleware(authConfig))
	app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("OK")
	})

	b.Run("NoAuth", func(b *testing.B) {
		b.ReportAllocs()
		b.ResetTimer()

		for i := 0; i < b.N; i++ {
			req := httptest.NewRequest("GET", "/test", nil)

			resp, err := app.Test(req)
			require.NoError(b, err)
			resp.Body.Close()
		}
	})

	b.Run("BasicAuth", func(b *testing.B) {
		b.ReportAllocs()
		b.ResetTimer()

		for i := 0; i < b.N; i++ {
			req := httptest.NewRequest("GET", "/test", nil)
			req.SetBasicAuth("testuser", "testpass")

			resp, err := app.Test(req)
			require.NoError(b, err)
			resp.Body.Close()
		}
	})
}

// BenchmarkCORSMiddleware CORS 미들웨어 성능 벤치마크
func BenchmarkCORSMiddleware(b *testing.B) {
	corsConfigs := []struct {
		name    string
		origins []string
		methods []string
		headers []string
	}{
		{
			name:    "Simple",
			origins: []string{"*"},
			methods: []string{"GET", "POST"},
			headers: []string{"Content-Type"},
		},
		{
			name:    "Medium",
			origins: []string{"http://localhost:3000", "https://example.com"},
			methods: []string{"GET", "POST", "PUT", "DELETE", "OPTIONS"},
			headers: []string{"Content-Type", "Authorization", "X-Requested-With"},
		},
		{
			name: "Complex",
			origins: []string{
				"http://localhost:3000", "http://localhost:8080",
				"https://example.com", "https://api.example.com",
				"https://admin.example.com",
			},
			methods: []string{
				"GET", "POST", "PUT", "DELETE", "OPTIONS",
				"PATCH", "HEAD",
			},
			headers: []string{
				"Content-Type", "Authorization", "X-Requested-With",
				"X-API-Key", "X-Client-Version", "X-Request-ID",
			},
		},
	}

	for _, config := range corsConfigs {
		b.Run(config.name, func(b *testing.B) {
			app := fiber.New(fiber.Config{
				DisableStartupMessage: true,
			})

			securityConfig := configs.SecurityConfig{
				CORS: configs.CORSConfig{
					Enabled:      true,
					AllowOrigins: config.origins,
					AllowMethods: config.methods,
					AllowHeaders: config.headers,
				},
			}

			app.Use(middlewares.SecurityMiddleware(securityConfig))
			app.Get("/test", func(c *fiber.Ctx) error {
				return c.SendString("OK")
			})

			b.ResetTimer()
			b.ReportAllocs()

			for i := 0; i < b.N; i++ {
				req := httptest.NewRequest("GET", "/test", nil)
				req.Header.Set("Origin", "https://example.com")

				resp, err := app.Test(req)
				require.NoError(b, err)
				resp.Body.Close()
			}
		})
	}
}

// BenchmarkCompressionMiddleware 압축 미들웨어 성능 벤치마크
func BenchmarkCompressionMiddleware(b *testing.B) {
	// 다양한 크기의 응답 데이터 테스트
	responseSizes := []struct {
		name string
		size int
	}{
		{"1KB", 1024},
		{"10KB", 10 * 1024},
		{"100KB", 100 * 1024},
		{"1MB", 1024 * 1024},
	}

	for _, responseSize := range responseSizes {
		testData := bytes.Repeat([]byte("test data for compression benchmark "), responseSize.size/36)

		b.Run("NoCompression_"+responseSize.name, func(b *testing.B) {
			app := fiber.New(fiber.Config{
				DisableStartupMessage: true,
			})

			app.Get("/test", func(c *fiber.Ctx) error {
				return c.Send(testData)
			})

			b.SetBytes(int64(responseSize.size))
			b.ReportAllocs()
			b.ResetTimer()

			for i := 0; i < b.N; i++ {
				req := httptest.NewRequest("GET", "/test", nil)

				resp, err := app.Test(req)
				require.NoError(b, err)
				io.Copy(io.Discard, resp.Body)
				resp.Body.Close()
			}
		})

		b.Run("WithCompression_"+responseSize.name, func(b *testing.B) {
			app := fiber.New(fiber.Config{
				DisableStartupMessage: true,
			})

			app.Use(middlewares.CompressionMiddleware())
			app.Get("/test", func(c *fiber.Ctx) error {
				return c.Send(testData)
			})

			b.SetBytes(int64(responseSize.size))
			b.ReportAllocs()
			b.ResetTimer()

			for i := 0; i < b.N; i++ {
				req := httptest.NewRequest("GET", "/test", nil)
				req.Header.Set("Accept-Encoding", "gzip")

				resp, err := app.Test(req)
				require.NoError(b, err)
				io.Copy(io.Discard, resp.Body)
				resp.Body.Close()
			}
		})
	}
}

// BenchmarkMiddlewareStack 미들웨어 스택 전체 성능 벤치마크
func BenchmarkMiddlewareStack(b *testing.B) {
	app := fiber.New(fiber.Config{
		DisableStartupMessage: true,
	})

	// 전체 미들웨어 스택 설정
	securityConfig := configs.SecurityConfig{
		RateLimit: configs.RateLimitConfig{
			Enabled:  true,
			Requests: 10000,
			Window:   60,
		},
		CORS: configs.CORSConfig{
			Enabled:      true,
			AllowOrigins: []string{"*"},
			AllowMethods: []string{"GET", "POST", "PUT", "DELETE"},
			AllowHeaders: []string{"Content-Type", "Authorization"},
		},
	}

	loggingConfig := configs.LoggingConfig{
		Level:     "info",
		Format:    "json",
		AccessLog: true,
	}

	metricsConfig := configs.MetricsConfig{
		Enabled: true,
		Path:    "/metrics",
	}

	// 미들웨어 스택 적용
	app.Use(middlewares.SecurityMiddleware(securityConfig))
	app.Use(middlewares.LoggingMiddleware(loggingConfig))
	app.Use(middlewares.MetricsMiddleware(metricsConfig))
	app.Use(middlewares.CompressionMiddleware())

	app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("OK")
	})

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("GET", "/test", nil)
		req.Header.Set("User-Agent", "Benchmark-Test/1.0")
		req.Header.Set("Accept-Encoding", "gzip")
		req.Header.Set("Origin", "https://example.com")

		resp, err := app.Test(req)
		require.NoError(b, err)
		require.Equal(b, http.StatusOK, resp.StatusCode)
		resp.Body.Close()
	}
}

// BenchmarkMiddlewareConcurrency 미들웨어 동시 처리 성능 벤치마크
func BenchmarkMiddlewareConcurrency(b *testing.B) {
	app := fiber.New(fiber.Config{
		DisableStartupMessage: true,
	})

	securityConfig := configs.SecurityConfig{
		RateLimit: configs.RateLimitConfig{
			Enabled:  true,
			Requests: 100000,
			Window:   60,
		},
	}

	app.Use(middlewares.SecurityMiddleware(securityConfig))
	app.Get("/test", func(c *fiber.Ctx) error {
		// 약간의 처리 시간 시뮬레이션
		time.Sleep(1 * time.Millisecond)
		return c.SendString("OK")
	})

	b.ResetTimer()
	b.ReportAllocs()

	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			req := httptest.NewRequest("GET", "/test", nil)
			req.Header.Set("X-Forwarded-For", "192.168.1.100")

			resp, err := app.Test(req)
			if err != nil {
				b.Errorf("Request failed: %v", err)
				continue
			}
			resp.Body.Close()
		}
	})
}
