package benchmark

import (
	"bytes"
	"io"
	"net/http"
	"net/http/httptest"
	"testing"
	"time"

	"github.com/gofiber/fiber/v2"
	"github.com/stretchr/testify/require"

	"proxynd/configs"
	"proxynd/middlewares"
)

// BenchmarkSecurityMiddleware 보안 미들웨어 성능 벤치마크
func BenchmarkSecurityMiddleware(b *testing.B) {
	app := fiber.New(fiber.Config{
		DisableStartupMessage: true,
	})

	// 기본 보안 설정
	securityConfig := configs.SecurityConfig{
		RateLimit: configs.RateLimitConfig{
			Enabled:  true,
			Requests: 1000,
			Window:   60,
		},
		CORS: configs.CORSConfig{
			Enabled:      true,
			AllowOrigins: []string{"*"},
			AllowMethods: []string{"GET", "POST", "PUT", "DELETE"},
			AllowHeaders: []string{"Content-Type", "Authorization"},
		},
		Headers: configs.SecurityHeadersConfig{
			EnableCSP:               true,
			EnableHSTS:              true,
			EnableXFrameOptions:     true,
			EnableXContentType:      true,
			EnableReferrerPolicy:    true,
			EnablePermissionsPolicy: true,
		},
	}

	// 보안 미들웨어 적용
	app.Use(middlewares.SecurityMiddleware(securityConfig))

	// 테스트 핸들러
	app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("OK")
	})

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("GET", "/test", nil)
		req.Header.Set("User-Agent", "Benchmark-Test/1.0")
		req.Header.Set("X-Forwarded-For", "192.168.1.100")

		resp, err := app.Test(req)
		require.NoError(b, err)
		require.Equal(b, http.StatusOK, resp.StatusCode)
		resp.Body.Close()
	}
}

// BenchmarkRateLimitMiddleware 속도 제한 미들웨어 성능 벤치마크
func BenchmarkRateLimitMiddleware(b *testing.B) {
	rateLimitConfigs := []struct {
		name     string
		requests int
		window   int
	}{
		{"Low_100req_60s", 100, 60},
		{"Medium_1000req_60s", 1000, 60},
		{"High_10000req_60s", 10000, 60},
		{"VeryHigh_100000req_60s", 100000, 60},
	}

	for _, config := range rateLimitConfigs {
		b.Run(config.name, func(b *testing.B) {
			app := fiber.New(fiber.Config{
				DisableStartupMessage: true,
			})

			securityConfig := configs.SecurityConfig{
				RateLimit: configs.RateLimitConfig{
					Enabled:  true,
					Requests: config.requests,
					Window:   config.window,
				},
			}

			app.Use(middlewares.SecurityMiddleware(securityConfig))
			app.Get("/test", func(c *fiber.Ctx) error {
				return c.SendString("OK")
			})

			b.ResetTimer()
			b.ReportAllocs()

			for i := 0; i < b.N; i++ {
				req := httptest.NewRequest("GET", "/test", nil)
				req.Header.Set("X-Forwarded-For", "192.168.1.100")

				resp, err := app.Test(req)
				require.NoError(b, err)
				resp.Body.Close()
			}
		})
	}
}

// BenchmarkLoggingMiddleware 로깅 미들웨어 성능 벤치마크
func BenchmarkLoggingMiddleware(b *testing.B) {
	app := fiber.New(fiber.Config{
		DisableStartupMessage: true,
	})

	// 로깅 설정
	loggingConfig := configs.LoggingConfig{
		Level:      "info",
		Format:     "json",
		AccessLog:  true,
		OutputPath: "/dev/null", // 벤치마크에서는 출력 비활성화
	}

	app.Use(middlewares.LoggingMiddleware(loggingConfig))
	app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("OK")
	})

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("GET", "/test", nil)
		req.Header.Set("User-Agent", "Benchmark-Test/1.0")

		resp, err := app.Test(req)
		require.NoError(b, err)
		require.Equal(b, http.StatusOK, resp.StatusCode)
		resp.Body.Close()
	}
}

