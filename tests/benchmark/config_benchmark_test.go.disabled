package benchmark

import (
	"context"
	"fmt"
	"os"
	"path/filepath"
	"sync"
	"testing"
	"time"

	"proxynd/configs"
	"proxynd/internal/services/config"
)

// BenchmarkConfigLoading 설정 로딩 성능 벤치마크
func BenchmarkConfigLoading(b *testing.B) {
	tempDir := b.TempDir()

	// 테스트 설정 파일들 생성
	createTestConfigFiles(b, tempDir)

	// 환경 변수 설정
	originalConfigDir := os.Getenv("CONFIG_DIR")
	defer func() {
		if originalConfigDir != "" {
			os.Setenv("CONFIG_DIR", originalConfigDir)
		} else {
			os.Unsetenv("CONFIG_DIR")
		}
	}()
	os.Setenv("CONFIG_DIR", tempDir)

	configTypes := []string{"global", "apt", "maven", "npm", "docker", "pip", "yum", "apk"}

	for _, configType := range configTypes {
		b.Run(fmt.Sprintf("Load_%s_config", configType), func(b *testing.B) {
			ctx := context.Background()
			configService, err := config.NewService(ctx, tempDir)
			if err != nil {
				b.Fatalf("Failed to create config service: %v", err)
			}

			b.ReportAllocs()
			b.ResetTimer()

			for i := 0; i < b.N; i++ {
				switch configType {
				case "global":
					_, err := configService.GetGlobalConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load global config: %v", err)
					}
				case "apt":
					_, err := configService.GetAptConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load apt config: %v", err)
					}
				case "maven":
					_, err := configService.GetMavenConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load maven config: %v", err)
					}
				case "npm":
					_, err := configService.GetNpmConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load npm config: %v", err)
					}
				case "docker":
					_, err := configService.GetDockerConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load docker config: %v", err)
					}
				case "pip":
					_, err := configService.GetPipConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load pip config: %v", err)
					}
				case "yum":
					_, err := configService.GetYumConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load yum config: %v", err)
					}
				case "apk":
					_, err := configService.GetApkConfig(ctx)
					if err != nil {
						b.Fatalf("Failed to load apk config: %v", err)
					}
				}
			}
		})
	}
}

// BenchmarkConfigParsing 설정 파싱 성능 벤치마크
func BenchmarkConfigParsing(b *testing.B) {
	// 다양한 크기의 설정 파일 벤치마크
	configSizes := []struct {
		name     string
		proxies  int
		mirrors  int
	}{
		{"Small_1proxy", 1, 2},
		{"Medium_10proxies", 10, 5},
		{"Large_100proxies", 100, 10},
		{"XLarge_1000proxies", 1000, 20},
	}

	for _, size := range configSizes {
		b.Run(fmt.Sprintf("Parse_%s", size.name), func(b *testing.B) {
			tempDir := b.TempDir()

			// 대용량 설정 파일 생성
			createLargeConfigFile(b, tempDir, size.proxies, size.mirrors)

			originalConfigDir := os.Getenv("CONFIG_DIR")
			defer func() {
				if originalConfigDir != "" {
					os.Setenv("CONFIG_DIR", originalConfigDir)
				} else {
					os.Unsetenv("CONFIG_DIR")
				}
			}()
			os.Setenv("CONFIG_DIR", tempDir)

			ctx := context.Background()
			configService, err := config.NewService(ctx, tempDir)
			if err != nil {
				b.Fatalf("Failed to create config service: %v", err)
			}

			b.ReportAllocs()
			b.ResetTimer()

			for i := 0; i < b.N; i++ {
				_, err := configService.GetAptConfig(ctx)
				if err != nil {
					b.Fatalf("Failed to parse config: %v", err)
				}
			}
		})
	}
}

// BenchmarkConfigConcurrency 설정 동시 접근 성능 벤치마크
func BenchmarkConfigConcurrency(b *testing.B) {
	tempDir := b.TempDir()
	createTestConfigFiles(b, tempDir)

	originalConfigDir := os.Getenv("CONFIG_DIR")
	defer func() {
		if originalConfigDir != "" {
			os.Setenv("CONFIG_DIR", originalConfigDir)
		} else {
			os.Unsetenv("CONFIG_DIR")
		}
	}()
	os.Setenv("CONFIG_DIR", tempDir)

	configService, err := config.NewService(ctx, tempDir)
	if err != nil {
		b.Fatalf("Failed to create config service: %v", err)
	}
	ctx := context.Background()

	b.Run("ConcurrentReads", func(b *testing.B) {
		b.ReportAllocs()
		b.ResetTimer()

		b.RunParallel(func(pb *testing.PB) {
			for pb.Next() {
				configTypes := []string{"apt", "maven", "npm"}
				configType := configTypes[b.N%len(configTypes)]

				switch configType {
				case "apt":
					_, err := configService.GetAptConfig(ctx)
					if err != nil {
						b.Errorf("Failed to load apt config: %v", err)
					}
				case "maven":
					_, err := configService.GetMavenConfig(ctx)
					if err != nil {
						b.Errorf("Failed to load maven config: %v", err)
					}
				case "npm":
					_, err := configService.GetNpmConfig(ctx)
					if err != nil {
						b.Errorf("Failed to load npm config: %v", err)
					}
				}
			}
		})
	})
}

// BenchmarkConfigValidation 설정 검증 성능 벤치마크
func BenchmarkConfigValidation(b *testing.B) {
	// 다양한 복잡도의 설정 검증
	validationCases := []struct {
		name   string
		config interface{}
	}{
		{
			name: "SimpleAPTConfig",
			config: &configs.APTProxyConfig{
				Proxies: map[string]configs.APTProxy{
					"ubuntu": {
						Name:     "ubuntu",
						URL:      "http://archive.ubuntu.com/ubuntu",
						Enabled:  true,
						Priority: 1,
						Cache: configs.CacheConfig{
							TTL:     3600,
							Enabled: true,
						},
					},
				},
			},
		},
		{
			name: "ComplexMavenConfig",
			config: &configs.MavenProxyConfig{
				Proxies: map[string]configs.MavenProxy{
					"central": {
						Name:     "central",
						URL:      "https://repo1.maven.org/maven2",
						Enabled:  true,
						Priority: 1,
						Cache: configs.CacheConfig{
							TTL:     7200,
							Enabled: true,
						},
						Auth: configs.AuthConfig{
							Enabled: true,
							BasicAuth: configs.BasicAuthConfig{
								Enabled: true,
								Users: map[string]string{
									"user1": "pass1",
									"user2": "pass2",
								},
							},
						},
						Security: configs.SecurityConfig{
							RateLimit: configs.RateLimitConfig{
								Enabled:  true,
								Requests: 1000,
								Window:   60,
							},
						},
					},
				},
			},
		},
	}

	for _, testCase := range validationCases {
		b.Run(fmt.Sprintf("Validate_%s", testCase.name), func(b *testing.B) {
			b.ReportAllocs()
			b.ResetTimer()

			for i := 0; i < b.N; i++ {
				// 설정 검증 로직 (실제 구현에서는 validator 사용)
				err := validateConfig(testCase.config)
				if err != nil {
					b.Fatalf("Config validation failed: %v", err)
				}
			}
		})
	}
}

// BenchmarkConfigHotReload 설정 핫 리로드 성능 벤치마크
func BenchmarkConfigHotReload(b *testing.B) {
	tempDir := b.TempDir()
	createTestConfigFiles(b, tempDir)

	originalConfigDir := os.Getenv("CONFIG_DIR")
	defer func() {
		if originalConfigDir != "" {
			os.Setenv("CONFIG_DIR", originalConfigDir)
		} else {
			os.Unsetenv("CONFIG_DIR")
		}
	}()
	os.Setenv("CONFIG_DIR", tempDir)

	configService, err := config.NewService(ctx, tempDir)
	if err != nil {
		b.Fatalf("Failed to create config service: %v", err)
	}
	ctx := context.Background()

	b.Run("HotReload", func(b *testing.B) {
		b.ReportAllocs()
		b.ResetTimer()

		for i := 0; i < b.N; i++ {
			// 설정 파일 수정 시뮬레이션
			modifyConfigFile(tempDir, i)

			// 리로드 수행
			err := configService.Reload(ctx)
			if err != nil {
				b.Fatalf("Config reload failed: %v", err)
			}
		}
	})
}

// BenchmarkConfigMemoryUsage 설정 메모리 사용량 벤치마크
func BenchmarkConfigMemoryUsage(b *testing.B) {
	tempDir := b.TempDir()

	memorySizes := []int{10, 100, 1000, 10000}

	for _, size := range memorySizes {
		b.Run(fmt.Sprintf("Memory_%dproxies", size), func(b *testing.B) {
			createLargeConfigFile(b, tempDir, size, 5)

			originalConfigDir := os.Getenv("CONFIG_DIR")
			defer func() {
				if originalConfigDir != "" {
					os.Setenv("CONFIG_DIR", originalConfigDir)
				} else {
					os.Unsetenv("CONFIG_DIR")
				}
			}()
			os.Setenv("CONFIG_DIR", tempDir)

			b.ReportAllocs()
			b.ResetTimer()

			var configs []interface{}
			for i := 0; i < b.N; i++ {
				configService, err := config.NewService(ctx, tempDir)
	if err != nil {
		b.Fatalf("Failed to create config service: %v", err)
	}
				ctx := context.Background()

				aptConfig, err := configService.GetAptConfig(ctx)
				if err != nil {
					b.Fatalf("Failed to load config: %v", err)
				}
				configs = append(configs, aptConfig)
			}

			// 메모리 사용량 측정을 위해 configs 사용
			_ = len(configs)
		})
	}
}

// createTestConfigFiles 테스트용 설정 파일들 생성
func createTestConfigFiles(b *testing.B, tempDir string) {
	b.Helper()

	// global.yaml
	globalConfig := `
server:
  port: 8080
  host: "0.0.0.0"
  read_timeout: 30
  write_timeout: 30

logging:
  level: "info"
  format: "json"
  access_log: true

metrics:
  enabled: true
  path: "/metrics"

cache:
  ttl: 3600
  max_size: "1GB"
`
	err := os.WriteFile(filepath.Join(tempDir, "global.yaml"), []byte(globalConfig), 0644)
	if err != nil {
		b.Fatalf("Failed to create global config: %v", err)
	}

	// apt-proxy.yaml
	aptConfig := `
proxies:
  ubuntu:
    name: "ubuntu"
    url: "http://archive.ubuntu.com/ubuntu"
    enabled: true
    priority: 1
    cache:
      ttl: 3600
      enabled: true
  debian:
    name: "debian"
    url: "http://deb.debian.org/debian"
    enabled: true
    priority: 2
    cache:
      ttl: 3600
      enabled: true
`
	err = os.WriteFile(filepath.Join(tempDir, "apt-proxy.yaml"), []byte(aptConfig), 0644)
	if err != nil {
		b.Fatalf("Failed to create apt config: %v", err)
	}

	// maven-proxy.yaml
	mavenConfig := `
proxies:
  central:
    name: "central"
    url: "https://repo1.maven.org/maven2"
    enabled: true
    priority: 1
    cache:
      ttl: 7200
      enabled: true
`
	err = os.WriteFile(filepath.Join(tempDir, "maven-proxy.yaml"), []byte(mavenConfig), 0644)
	if err != nil {
		b.Fatalf("Failed to create maven config: %v", err)
	}

	// npm-proxy.yaml
	npmConfig := `
proxies:
  npmjs:
    name: "npmjs"
    url: "https://registry.npmjs.org"
    enabled: true
    priority: 1
    cache:
      ttl: 1800
      enabled: true
`
	err = os.WriteFile(filepath.Join(tempDir, "npm-proxy.yaml"), []byte(npmConfig), 0644)
	if err != nil {
		b.Fatalf("Failed to create npm config: %v", err)
	}
}

// createLargeConfigFile 대용량 설정 파일 생성
func createLargeConfigFile(b *testing.B, tempDir string, proxies, mirrors int) {
	b.Helper()

	config := "proxies:\n"

	for i := 0; i < proxies; i++ {
		config += fmt.Sprintf(`  proxy%d:
    name: "proxy%d"
    url: "http://mirror%d.example.com/ubuntu"
    enabled: true
    priority: %d
    cache:
      ttl: 3600
      enabled: true
    mirrors:
`, i, i, i%mirrors, i+1)

		for j := 0; j < mirrors; j++ {
			config += fmt.Sprintf(`      - url: "http://mirror%d-%d.example.com/ubuntu"
        priority: %d
`, i, j, j+1)
		}
	}

	err := os.WriteFile(filepath.Join(tempDir, "apt-proxy.yaml"), []byte(config), 0644)
	if err != nil {
		b.Fatalf("Failed to create large config: %v", err)
	}
}

// modifyConfigFile 설정 파일 수정 (핫 리로드 테스트용)
func modifyConfigFile(tempDir string, iteration int) {
	configPath := filepath.Join(tempDir, "apt-proxy.yaml")

	config := fmt.Sprintf(`
proxies:
  ubuntu:
    name: "ubuntu"
    url: "http://archive.ubuntu.com/ubuntu"
    enabled: true
    priority: 1
    cache:
      ttl: %d
      enabled: true
  modified_proxy_%d:
    name: "modified_%d"
    url: "http://new-mirror-%d.example.com/ubuntu"
    enabled: true
    priority: 2
    cache:
      ttl: 1800
      enabled: true
`, 3600+iteration, iteration, iteration, iteration)

	os.WriteFile(configPath, []byte(config), 0644)
}

// validateConfig 설정 검증 (예시 구현)
func validateConfig(config interface{}) error {
	// 실제 구현에서는 구조체 태그나 validator 라이브러리 사용
	switch cfg := config.(type) {
	case *configs.APTProxyConfig:
		if len(cfg.Proxies) == 0 {
			return fmt.Errorf("no proxies configured")
		}
		for name, proxy := range cfg.Proxies {
			if proxy.Name == "" {
				return fmt.Errorf("proxy %s has no name", name)
			}
			if proxy.URL == "" {
				return fmt.Errorf("proxy %s has no URL", name)
			}
		}
	case *configs.MavenProxyConfig:
		if len(cfg.Proxies) == 0 {
			return fmt.Errorf("no proxies configured")
		}
		for name, proxy := range cfg.Proxies {
			if proxy.Name == "" {
				return fmt.Errorf("proxy %s has no name", name)
			}
			if proxy.URL == "" {
				return fmt.Errorf("proxy %s has no URL", name)
			}
		}
	}
	return nil
}
