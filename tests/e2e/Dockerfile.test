# Step 4-1: 향상된 테스트 러너 컨테이너
FROM alpine:3.18

# 필수 패키지 설치
RUN apk add --no-cache \
    bash \
    curl \
    wget \
    jq \
    git \
    ca-certificates \
    openssl \
    tar \
    gzip \
    docker-cli \
    docker-compose

# Node.js (NPM 테스트용)
RUN apk add --no-cache nodejs npm

# Python (PIP 테스트용) 
RUN apk add --no-cache python3 py3-pip

# Java/Maven (Maven 테스트용)
RUN apk add --no-cache openjdk11-jre maven

# 테스트 도구들
RUN apk add --no-cache \
    parallel \
    rsync \
    findutils \
    coreutils \
    util-linux

# 작업 디렉토리 생성
WORKDIR /tests

# 결과 디렉토리 생성
RUN mkdir -p /results /cache /workspace

# 테스트 러너 스크립트 복사
COPY tests/e2e/scripts/run-all-tests.sh /usr/local/bin/run-all-tests
COPY tests/e2e/scripts/parallel-test-runner.sh /usr/local/bin/parallel-test-runner

# 실행 권한 부여
RUN chmod +x /usr/local/bin/run-all-tests /usr/local/bin/parallel-test-runner

# 헬스 체크 파일 생성 스크립트
RUN echo '#!/bin/bash' > /usr/local/bin/create-health \
    && echo 'touch /results/health' >> /usr/local/bin/create-health \
    && chmod +x /usr/local/bin/create-health

# 환경 변수 설정
ENV PATH="/usr/local/bin:${PATH}"
ENV TEST_RESULTS_DIR="/results"
ENV TEST_CACHE_DIR="/cache"
ENV TEST_WORKSPACE_DIR="/workspace"

# 기본 명령어
CMD ["/usr/local/bin/run-all-tests"]