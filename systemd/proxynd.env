# ProxyND 환경 변수 설정 파일
# 이 파일을 /etc/default/proxynd에 복사하여 사용하세요

# 서버 설정
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# 디렉토리 설정
CONFIG_DIR=/etc/proxynd
STORAGE_DIR=/var/lib/proxynd

# 로깅 설정
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/proxynd/proxynd.log
ACCESS_LOG_PATH=/var/log/proxynd/access.log

# 캐시 설정
CACHE_TYPE=filesystem
CACHE_TTL=3600
CACHE_MAX_SIZE=10737418240

# 인증 설정 (선택사항)
# AUTH_ENABLED=true
# AUTH_TYPE=basic

# 프록시 설정
NPM_PROXY_ENABLED=true
NPM_PROXY_UPSTREAM=https://registry.npmjs.org

PIP_PROXY_ENABLED=true
PIP_PROXY_UPSTREAM=https://pypi.org/simple

APT_PROXY_ENABLED=true
APT_PROXY_UPSTREAM=http://archive.ubuntu.com/ubuntu

DOCKER_PROXY_ENABLED=true
DOCKER_PROXY_UPSTREAM=https://registry-1.docker.io

# 메트릭 설정
METRICS_ENABLED=true
METRICS_AUTH_ENABLED=false

# 성능 튜닝
GOMAXPROCS=0
GOMEMLIMIT=0