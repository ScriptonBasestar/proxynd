{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feature", "enhancement"]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["bug", "fix"]
    },
    {
      "title": "## 🔨 Refactoring",
      "labels": ["refactor", "refactoring"]
    },
    {
      "title": "## ⚡ Performance",
      "labels": ["performance", "perf"]
    },
    {
      "title": "## 🔒 Security",
      "labels": ["security"]
    },
    {
      "title": "## 📝 Documentation",
      "labels": ["documentation", "docs"]
    },
    {
      "title": "## 🧰 Maintenance",
      "labels": ["chore", "maintenance", "ci", "build"]
    },
    {
      "title": "## ⬆️ Dependencies",
      "labels": ["dependencies", "deps"]
    }
  ],
  "ignore_labels": [
    "ignore-for-release",
    "duplicate",
    "question",
    "invalid",
    "wontfix"
  ],
  "sort": {
    "order": "ASC",
    "on_property": "mergedAt"
  },
  "template": "${{CHANGELOG}}\n\n**Full Changelog**: ${{RELEASE_DIFF}}\n\n## Contributors\n\n${{CONTRIBUTORS}}",
  "pr_template": "- ${{TITLE}} by @${{AUTHOR}} in #${{NUMBER}}",
  "empty_template": "- No changes",
  "label_extractor": [
    {
      "pattern": "(feat|feature)\\((\\w+)\\)",
      "target": "$1",
      "on_property": "title"
    },
    {
      "pattern": "(fix|bug)\\((\\w+)\\)",
      "target": "$1",
      "on_property": "title"
    },
    {
      "pattern": "(refactor)\\((\\w+)\\)",
      "target": "$1",
      "on_property": "title"
    }
  ],
  "duplicate_filter": {
    "pattern": "^(Merge pull request|Merge branch)",
    "on_property": "title",
    "method": "match"
  },
  "transformers": [
    {
      "pattern": "^(\\[.*\\]\\s*)?(.*)$",
      "target": "$2",
      "on_property": "title"
    }
  ],
  "max_tags_to_fetch": 200,
  "max_pull_requests": 200,
  "max_back_track_time_days": 365,
  "exclude_merge_branches": [
    "main",
    "master",
    "develop"
  ],
  "tag_resolver": {
    "method": "semver",
    "filter": {
      "pattern": "v(.+)",
      "flags": "i"
    }
  },
  "base_branches": [
    "main",
    "master"
  ]
}
