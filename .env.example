# ProxyND Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development
CONFIG_DIR=./tmp/config
STORAGE_DIR=./tmp/storage

# Security (Required in Production)
JWT_SECRET=your-jwt-secret-key-here-minimum-32-chars-change-this-in-production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7

# Encryption Keys (Required in Production)
ENCRYPTION_KEY=your-encryption-key-here-minimum-32-chars
SIGNING_KEY=your-signing-key-here-minimum-32-chars

# OAuth2 Providers (Optional)
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_GITLAB_CLIENT_ID=your-gitlab-client-id
OAUTH_GITLAB_CLIENT_SECRET=your-gitlab-client-secret
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database Configuration (Optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proxynd
DB_USER=proxynd
DB_PASSWORD=your-database-password
DB_SSL_MODE=disable

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Package Registry Credentials (Optional)
REGISTRY_MAVEN_USERNAME=
REGISTRY_MAVEN_PASSWORD=
REGISTRY_NPM_TOKEN=
REGISTRY_DOCKER_USERNAME=
REGISTRY_DOCKER_PASSWORD=

# External Service API Keys (Optional)
API_KEY_NEXUS=
API_KEY_ARTIFACTORY=
API_KEY_HARBOR=

# Upstream Proxy Authentication (Optional)
UPSTREAM_PROXY_USERNAME=
UPSTREAM_PROXY_PASSWORD=

# Cache Configuration
CACHE_TYPE=filesystem
CACHE_TTL=3600
CACHE_MAX_SIZE=1024

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics and Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
SENTRY_DSN=
DATADOG_API_KEY=
SLACK_WEBHOOK_URL=

# External Services
UPSTREAM_TIMEOUT=30s
MAX_CONCURRENT_DOWNLOADS=10

# Development
DEBUG=false
HOT_RELOAD=true