{
	"info": {
		"_postman_id": "proxynd-enterprise-api-v1",
		"name": "ProxyND Enterprise API",
		"description": "Complete collection for ProxyND Enterprise API with 47 endpoints covering RBAC, Audit, Analytics, Security, Alerts, and License management.\n\n## Categories\n- **RBAC** (12 endpoints): Role-based access control, permissions, user assignments\n- **Audit** (8 endpoints): Event logging, compliance reports, audit trail export\n- **Analytics** (10 endpoints): Usage stats, performance metrics, cost analysis\n- **Security** (8 endpoints): Vulnerability scanning, license compliance, malware detection\n- **Alerts** (5 endpoints): Alert management and notification rules\n- **License** (4 endpoints): License validation and feature management\n\n## Authentication\n- Development mode: No authentication required\n- Production mode: Bearer token required in Authorization header\n\n## Base URL\nUse the `{{baseUrl}}` variable configured in the environment.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
