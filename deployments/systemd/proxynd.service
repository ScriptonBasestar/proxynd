[Unit]
Description=ProxyND - Multi-format Package Registry Proxy Server
Documentation=https://github.com/scriptonbasestar/proxynd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxynd
Group=proxynd
WorkingDirectory=/opt/proxynd

# 환경 변수 설정
Environment="SERVER_PORT=8080"
Environment="CONFIG_DIR=/etc/proxynd"
Environment="STORAGE_DIR=/var/lib/proxynd"
Environment="LOG_LEVEL=info"
Environment="LOG_FORMAT=json"

# 환경 파일 (선택사항)
EnvironmentFile=-/etc/default/proxynd

# 실행 명령
ExecStart=/opt/proxynd/proxynd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

# 보안 설정
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/proxynd /var/log/proxynd
ReadOnlyPaths=/etc/proxynd

# 리소스 제한
LimitNOFILE=65536
LimitNPROC=4096
# 메모리 제한 (256MiB = 268435456 bytes)
LimitAS=268435456
# cgroup 메모리 제한 (Docker와 일관성 유지)
MemoryMax=512M
MemoryHigh=384M

# 로깅
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proxynd

[Install]
WantedBy=multi-user.target
