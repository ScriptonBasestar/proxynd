# Dockerfile for GoReleaser
# This is used by GoReleaser to build Docker images

FROM alpine:3.22

# Install ca-certificates for SSL/TLS support
RUN apk --no-cache add ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 -S proxynd && \
    adduser -u 1000 -S proxynd -G proxynd

# Create necessary directories
RUN mkdir -p /config /storage && \
    chown -R proxynd:proxynd /config /storage

# Copy the binary from GoReleaser
COPY proxynd /usr/local/bin/proxynd

# Copy example configuration
COPY examples /config/examples

# Set permissions
RUN chmod +x /usr/local/bin/proxynd

# Switch to non-root user
USER proxynd

# Environment variables
ENV CONFIG_DIR=/config \
    STORAGE_DIR=/storage \
    SERVER_PORT=8080 \
    LOG_LEVEL=info \
    LOG_FORMAT=json \
    GOMAXPROCS=0 \
    GOMEMLIMIT=256MiB

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/healthz || exit 1

# Entry point
# ulimit -v: 가상 메모리 제한 (256MiB = 268435456 bytes)
# exec: PID 1 유지를 위해 shell을 binary로 교체
ENTRYPOINT ["/bin/sh", "-c", "ulimit -v 268435456 && exec /usr/local/bin/proxynd \"$@\"", "--"]
